<configs>
	<!--
		Zombies already have the ApproachDistraction AI task, which is what makes them chase thrown rocks.
		Animals do not, so bait would only ever pull zombies. This adds the task to each animal's own list (stags,
		does, boars, bears and chickens inherit it from the two animal templates). It sits after attacking and before
		Look/Wander, so a chasing animal still goes for a target first. Skipped: bosses, vultures, insect swarms.
	-->
	<remove xpath="/entity_classes/entity_class[@name='animalTemplateTimid']/property[starts-with(@name,'AITask-')]"/>
	<append xpath="/entity_classes/entity_class[@name='animalTemplateTimid']">
		<property name="AITask-1" value="RunawayWhenHurt"/>
		<property name="AITask-2" value="RunawayFromEntity"/>
		<property name="AITask-3" value="ApproachDistraction"/>
		<property name="AITask-4" value="Look"/>
		<property name="AITask-5" value="Wander"/>
	</append>
	<remove xpath="/entity_classes/entity_class[@name='animalTemplateHostile']/property[starts-with(@name,'AITask-')]"/>
	<append xpath="/entity_classes/entity_class[@name='animalTemplateHostile']">
		<property name="AITask-1" value="BreakBlock"/>
		<property name="AITask-2" value="ApproachAndAttackTarget"/>
		<property name="AITask-3" value="ApproachDistraction"/>
		<property name="AITask-4" value="ApproachSpot"/>
		<property name="AITask-5" value="Look"/>
		<property name="AITask-6" value="Wander"/>
	</append>
