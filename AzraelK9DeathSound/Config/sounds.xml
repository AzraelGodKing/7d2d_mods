<!--
  A pool of silly sounds that already ship with the game. Whenever one of the four dog-type animals is hurt, the game
  picks one of these clips at random. Add or remove AudioClip lines to change the pool (clip names come from
  Data/Config/sounds.xml). Works from the server alone: every player already has these clips.
-->
<configs>
<append xpath="/Sounds">
<SoundDataNode name="azraelK9Silly"> <AudioSource name="@:Sounds/Prefabs/AudioSource_PainLG.prefab"/>
	<Noise ID="2" noise="11" time="3" muffled_when_crouched="0.5"/>
