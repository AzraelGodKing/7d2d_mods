<Project>
  <!--
    Shared build settings for every mod in this repo.

    GameDir must point at a 7 Days to Die install; the projects compile against its DLLs
    (Assembly-CSharp, Unity, Harmony). Those DLLs are NOT in this repo.

    To use a different install on another PC, either:
      - create Directory.Build.local.props next to this file (it's gitignored) with
        <Project><PropertyGroup><GameDir>D:\Games\7 Days To Die</GameDir></PropertyGroup></Project>
      - or pass it on the command line:  .\build.ps1 -GameDir "D:\Games\7 Days To Die"
  -->
  <Import Project="Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">E:\SteamLibrary\steamapps\common\7 Days To Die</GameDir>
    <ManagedDir>$(GameDir)\7DaysToDie_Data\Managed</ManagedDir>
    <HarmonyDir>$(GameDir)\Mods\0_TFP_Harmony</HarmonyDir>

    <!-- The game runs on Mono / .NET Framework 4.x -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Authors>Azrael</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game assemblies: referenced from the install, never copied to the output -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LogLibrary"><HintPath>$(ManagedDir)\LogLibrary.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll')"
           Text="7 Days to Die not found at '$(GameDir)'. Set GameDir (see Directory.Build.props)." />
  </Target>
</Project>
