<configs>
	<!-- 1. Remove the unwanted entities from every entity group (biomes, POIs, wandering/blood moon/scout hordes). -->
	<remove xpath="/entitygroups/entitygroup/e[@n='animalZombieDog']" />
	<remove xpath="/entitygroups/entitygroup/e[@n='animalCoyote']" />
	<remove xpath="/entitygroups/entitygroup/e[@n='animalDireWolf']" />
	<remove xpath="/entitygroups/entitygroup/e[starts-with(@n,'zombieScreamer')]" />

	<!-- 2. Groups whose FIRST entry is now "none" (EnemyAnimalsSnowNight in vanilla: dog + dire wolf + none).
	     The game checks the first entry of a biome group to decide if it is an enemy group, and "none" is not
	     an entity class, which throws a NullReferenceException in EntityGroups.IsEnemyGroup every tick.
	     Put real zombies in front. Low weights so the "none" roll still keeps these spawns rare. -->
	<insertBefore xpath="/entitygroups/entitygroup[e[1][@n='none']]/e[1]">
		<e n="zombieArlene" p="2" />
		<e n="zombieBoe" p="2" />
		<e n="zombieJoe" p="2" />
		<e n="zombieMarlene" p="2" />
		<e n="zombieMoe" p="2" />
		<e n="zombieDarlene" p="2" />
		<e n="zombieYo" p="2" />
		<e n="zombieSteve" p="2" />
		<e n="zombieBusinessMan" p="2" />
		<e n="zombieJanitor" p="2" />
	</insertBefore>

	<!-- 3. Any group that is now completely empty gets the basic zombie pool; one is picked at random per spawn. -->
	<append xpath="/entitygroups/entitygroup[not(e)]">
		<e n="zombieArlene" />
		<e n="zombieBoe" />
		<e n="zombieJoe" />
		<e n="zombieMarlene" />
		<e n="zombieMoe" />
		<e n="zombieDarlene" />
		<e n="zombieYo" />
		<e n="zombieSteve" />
		<e n="zombieBusinessMan" />
		<e n="zombieJanitor" />
	</append>
</configs>
